<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:T3Simulator.GUI.Converters"
             x:Class="T3Simulator.GUI.App"
             RequestedThemeVariant="Dark">
    <Application.Resources>
        <conv:BooleanToBrushConverter x:Key="IsActiveToBrushConverter" 
                                      TrueBrush="#ff4ade80" 
                                      FalseBrush="#3f3f46" />
    </Application.Resources>
</Application>