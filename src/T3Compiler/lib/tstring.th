// T-lang String Library — tstring.th
// String manipulation functions for tryte arrays.
//
// NOTE: Search functions return tint index (0 = not found, 1..N = position)
// instead of tryte* pointer, for compatibility with the interpreter.

#ifndef _TSTRING_TH
#define _TSTRING_TH

// === Length and comparison ===
tint  t_strlen(tryte* str);
tint  t_strcmp(tryte* a, tryte* b);   // returns -1,0,+1
tint  t_strncmp(tryte* a, tryte* b, tint n);

// === Copy and concatenation ===
void  t_strcpy(tryte* dest, tryte* src);
void  t_strncpy(tryte* dest, tryte* src, tint n);
void  t_strcat(tryte* dest, tryte* src);

// === Search (return index: 0 = not found) ===
tint  t_strchr(tryte* str, tryte c);
tint  t_strrchr(tryte* str, tryte c);
tint  t_strstr(tryte* haystack, tryte* needle);

// === Conversion ===
tint   t_atoi(tryte* str);           // string to tint
void   t_itoa(tint value, tryte* buf);         // tint to string
void   t_baltoa(tint value, tryte* buf);       // to balanced ternary string

#endif // _TSTRING_TH