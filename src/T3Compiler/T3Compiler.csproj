<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>T3Compiler</RootNamespace>
    <AssemblyName>t3cc</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>T3-lang Compiler — translates T language to T3 ternary assembly</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TritTypes\TritTypes.csproj" />
    <ProjectReference Include="..\T3Simulator.Common\T3Simulator.Common.csproj" />
    <ProjectReference Include="..\T3Assembler\T3Assembler.csproj" />
  </ItemGroup>

</Project>